# Required environment variables for Production
# ------------------------------------------------
# Copy this file to .env, fill in real values, and never commit .env.
#
# ASP.NET Core maps double-underscore (__) to colon (:) so nested keys work:
#   ConnectionStrings__Default  →  ConnectionStrings:Default
#   Jwt__Secret                 →  Jwt:Secret
#   Seed__AdminPassword         →  Seed:AdminPassword

# Full ADO.NET connection string to the production SQL Server database
ConnectionStrings__Default=Server=tcp:<host>,1433;Initial Catalog=AttendanceSystem;User ID=<user>;Password=<password>;Encrypt=True;Connection Timeout=30;

# JWT signing secret — minimum 32 characters, use a cryptographically random value:
#   [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64) | ForEach-Object { [Convert]::ToBase64String($_) }
Jwt__Secret=

# Password for the seeded admin account (only applied on first startup when no admin exists)
Seed__AdminPassword=

# Optional overrides (defaults are in appsettings.json)
# ASPNETCORE_ENVIRONMENT=Production
# Cors__AllowedOrigin=https://your-frontend-domain.com
# Seed__AdminEmail=admin@yourcompany.com
